{
  "manifest_version": 3,
  "name": "Minuts al Jardí",
  "version": "1.1.0",
  "description": "Temporitzador de concentració que transforma cada minut completat en un pètal.",
  "author": "Evelyn Rosado Romero",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Minuts al Jardí"
  },

  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },

  "icons": {
    "48": "assets/icon48.png"
  },

  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "minuts-al-jardi@evelynrosado",
      "strict_min_version": "109.0"
    }
  }
}
